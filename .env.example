# Local demo mode. Set false only after configuring a real Hindsight bank.
DEMO_MODE=true

# Hindsight Cloud / server
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=sentinel-incident-memory
HINDSIGHT_AUTO_CREATE_BANK=false

# Optional Groq model for richer generation. Deterministic fallback works without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
